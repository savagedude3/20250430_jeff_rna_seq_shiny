go_ora %>%
dotplot(showCategory = 15) +
ggtitle("dotplot for ORA")
# heatplot
heatplot(go_ora, showCategory = 5)
# upsetplot
upsetplot(go_ora)
#save go output
go_mf.df <- data.frame(go_ora)
rownames(go_mf.df) <- NULL
