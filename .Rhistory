# # Install CRAN packages
# installifnot <- function(pckgName){
#   if (!(require(pckgName, character.only = TRUE))) {
#     install.packages(pckgName, dep = TRUE)
#     require(pckgName, character.only = TRUE)
#   }
# }
#
# cran_pkgs <- c("BiocManager", "remotes", "tidyverse")
#
# for (i in 1:length(cran_pkgs)){
#   installifnot(cran_pkgs[i])
# }
#
# # Install Bioconductor packages
# installBiocifnot <- function(pckgName){
#   if (!(require(pckgName, character.only = TRUE))) {
#     BiocManager::install(pckgName)
#     require(pckgName, character.only = TRUE)
#   }
# }
#
# bioc_pkgs <- c("DESeq2", "UCLouvain-CBIO/rWSBIM2122", "clusterProfiler", "biomaRt", "org.Mm.eg.db", "enrichplot", "fgsea")
#
# for (i in 1:length(bioc_pkgs)){
#   installBiocifnot(bioc_pkgs[i])
# }
# Load packages
library(rWSBIM2122)
library(DESeq2)
library(tidyverse)
library(clusterProfiler)
library(biomaRt)
library(org.Mm.eg.db)
library(enrichplot)
library(fgsea)
library(msigdbr)
library(ggrepel)
counts_dir <- "D:/Eroglu_lab/unix_programs/jeff_nlgn2_cko_rnaseq/20220331_Jeff_nlgn2_cKO_counts"
counts_list <- list.files(counts_dir, pattern='txt$')
#reads in each counts file
counts_in <- lapply(paste(counts_dir, counts_list, sep = "/"), read.table, header = TRUE)
#subset just the geneids and counts from each file so that each row is a gene and each column is the counts for a sample
counts_combined <- data.frame(counts_in[[1]][,7])
for (i in seq.int(2,length(counts_in))){
#print(i)
current_column <- counts_in[[i]][,7]
counts_combined[(i)] <- current_column
}
#label rows with gene names
rows <- counts_in[[1]][,1]
rownames(counts_combined) = rows
#label columns with names of input files
cols <- counts_list
colnames(counts_combined) = cols
#group samples by experimental groups
#1 het, 2 ko
group <- factor(c("het", "het", "het", "ko", "ko"))
#make coldata for DESeq2
coldata <- data.frame(cols)
#coldata$sample <- cols
coldata$Condition <- group
# Construct a DESeqDataSet object
dds <- DESeqDataSetFromMatrix(countData = counts_combined,
colData = coldata,
design = ~ Condition)
# Run DESeq2
dds <- DESeq(dds)
res <- results(dds,
contrast = c("Condition", "ko", "het")) # we do this so that `het` becomes the group we're comparing to
plotMA(res)
resultsNames(dds)
# Output -
# "Intercept"            "Condition_mock_vs_KD"
# How do we switch the order of the second coefficient so that this reads "Condition_KD_vs_mock"
coldata$Condition <- factor(coldata$Condition, levels = c("het", "ko"))
# Repeat DESeq steps
# Construct a DESeqDataSet object
dds <- DESeqDataSetFromMatrix(countData = counts_combined,
colData = coldata,
design = ~ Condition)
# Run DESeq2
dds <- DESeq(dds)
resultsNames(dds)
# Output -
# "Intercept"            "Condition_KD_vs_mock"
res_shrunk <- lfcShrink(dds,
coef = "Condition_ko_vs_het",
type = "apeglm")
# Here's a nice article on empirical Bayes estimation - http://varianceexplained.org/r/empirical_bayes_baseball/
res_shrunk
# Compare the output of -
plotMA(res)
# and
plotMA(res_shrunk)
# Convert `res_shrunk` to a dataframe called `res_df`. We will use this for enrichment analyses
res_df <- as_tibble(res_shrunk, rownames = "genes")
#save the diffexp data
#write.csv(res_df, file = "20241205_deseq2_bayes_estimation.csv")
# Get ENTREZ IDs
# We'll need this for using the "org.Mm.eg.db" package
# Step One: Connect to the selected BioMart database and dataset hosted by Ensembl
ensembl <- useEnsembl(biomart = "genes",
dataset = "mmusculus_gene_ensembl")
#ensembl <- useMart("ENSEMBL_MART_ENSEMBL", host="may2009.archive.ensembl.org", dataset="mmusculus_gene_ensembl")
# Step Two: Retrieve gene names
# build a biomaRt query
# The getBM() function is the main query function in biomaRt
ensembl_to_entrez <- getBM(attributes = c("ensembl_gene_id", "external_gene_name",
"entrezgene_id"),
values = res_df$genes,
mart = ensembl)
# add this new info to res_df
res_df <- res_df %>%
left_join(ensembl_to_entrez, by = c("genes" = "external_gene_name"))
# remove rows with NAs in the columns in `entrezgene_id` and `padj`
res_df <- res_df %>%
drop_na(entrezgene_id, padj)
# are all ENTREZ IDs unique?
length(unique(res_df$entrezgene_id))
nrow(res_df)
# drop duplicates
res_df <- res_df %>%
arrange(padj) %>%
distinct(entrezgene_id, .keep_all = TRUE)
# are all ENTREZ IDs unique?
length(unique(res_df$entrezgene_id)) == nrow(res_df) # TRUE
#save deseq output with ENTREZ IDs
#write.csv(res_df, file = "20250430_deseq2_entrez.csv")
# perform ORA
# we need a vector of ENTREZ IDs for genes with padj values < 0.05 and log2fc < -0.585 (1.5 fold decrease)
sig_genes_p_only <- res_df %>%
dplyr::filter(padj < 0.05) %>%
pull(entrezgene_id)
sig_genes_either_0_585 <- res_df %>%
dplyr::filter(padj < 0.05, abs(log2FoldChange) > 0.585) %>%
pull(entrezgene_id)
sig_genes_down_0_585 <- res_df %>%
dplyr::filter(padj < 0.05, log2FoldChange < -0.585) %>%
pull(entrezgene_id)
sig_genes_either_1 <- res_df %>%
dplyr::filter(padj < 0.05, abs(log2FoldChange) > 1) %>%
pull(entrezgene_id)
sig_genes_down_1 <- res_df %>%
dplyr::filter(padj < 0.05, log2FoldChange < -1) %>%
pull(entrezgene_id)
#GO for BP works, the others return empty results which is apparently correct if there is no significant enrichment.
#I switched to focusing on enrichments in the downregulated genes since there are a lot more of those.
go_ora <- enrichGO(gene = as.character(sig_genes_either_0_585),
OrgDb = org.Mm.eg.db,
universe = as.character(res_df$entrezgene_id),
ont = "MF",
readable = TRUE) # maps gene IDs to gene names
head(go_ora)
# Visualization
# dot plot
go_ora %>%
dotplot(showCategory = 15) +
ggtitle("dotplot for ORA")
# heatplot
heatplot(go_ora, showCategory = 5)
# upsetplot
upsetplot(go_ora)
#save go output
go_mf.df <- data.frame(go_ora)
rownames(go_mf.df) <- NULL
#write.csv(go_mf.df, file = "20241205_go_mf.csv")
go_ora <- enrichGO(gene = as.character(sig_genes_either_0_585),
OrgDb = org.Mm.eg.db,
universe = as.character(res_df$entrezgene_id),
ont = "CC",
readable = TRUE) # maps gene IDs to gene names
#save go output
go_cc.df <- data.frame(go_ora)
rownames(go_cc.df) <- NULL
#write.csv(go_cc.df, file = "20241205_go_cc.csv")
go_ora <- enrichGO(gene = as.character(sig_genes_either_0_585),
OrgDb = org.Mm.eg.db,
universe = as.character(res_df$entrezgene_id),
ont = "BP",
readable = TRUE) # maps gene IDs to gene names
#save go output
go_bp.df <- data.frame(go_ora)
rownames(go_bp.df) <- NULL
#write.csv(go_bp.df, file = "20241205_go_bp.csv")
go_ora %>%
dotplot(showCategory = 15) +
ggtitle("Nlgn2 cKO Downregulated GO")
go_ora %>%
dotplot(showCategory = 15) +
ggtitle("Nlgn2 cKO Downregulated GO")
ggplot() + go_ora %>%
dotplot(showCategory = 15) +
ggtitle("Nlgn2 cKO Downregulated GO")
runApp('app_new.R')
runApp('app_new.R')
runApp('app_new.R')
runApp('app_new.R')
runApp('app_new.R')
