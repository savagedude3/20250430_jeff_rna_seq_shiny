dplyr::filter(padj < 0.05, abs(log2FoldChange) > 1) %>%
pull(entrezgene_id)
sig_genes_down_1 <- res_df %>%
dplyr::filter(padj < 0.05, log2FoldChange < -1) %>%
pull(entrezgene_id)
#GO for BP works, the others return empty results which is apparently correct if there is no significant enrichment.
#I switched to focusing on enrichments in the downregulated genes since there are a lot more of those.
go_ora <- enrichGO(gene = as.character(sig_genes_either_0_585),
OrgDb = org.Mm.eg.db,
universe = as.character(res_df$entrezgene_id),
ont = "MF",
readable = TRUE) # maps gene IDs to gene names
head(go_ora)
# Visualization
