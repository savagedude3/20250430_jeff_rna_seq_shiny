counts_list <- list.files(counts_dir, pattern='txt$')
#reads in each counts file
counts_in <- lapply(paste(counts_dir, counts_list, sep = "/"), read.table, header = TRUE)
#subset just the geneids and counts from each file so that each row is a gene and each column is the counts for a sample
counts_combined <- data.frame(counts_in[[1]][,7])
for (i in seq.int(2,length(counts_in))){
#print(i)
current_column <- counts_in[[i]][,7]
counts_combined[(i)] <- current_column
}
#label rows with gene names
rows <- counts_in[[1]][,1]
rownames(counts_combined) = rows
#label columns with names of input files
cols <- counts_list
colnames(counts_combined) = cols
#group samples by experimental groups
#1 het, 2 ko
group <- factor(c("het", "het", "het", "ko", "ko"))
#make coldata for DESeq2
coldata <- data.frame(cols)
#coldata$sample <- cols
coldata$Condition <- group
# Construct a DESeqDataSet object
dds <- DESeqDataSetFromMatrix(countData = counts_combined,
colData = coldata,
design = ~ Condition)
# Run DESeq2
dds <- DESeq(dds)
res <- results(dds,
contrast = c("Condition", "ko", "het")) # we do this so that `het` becomes the group we're comparing to
plotMA(res)
resultsNames(dds)
# Output -
# "Intercept"            "Condition_mock_vs_KD"
# How do we switch the order of the second coefficient so that this reads "Condition_KD_vs_mock"
coldata$Condition <- factor(coldata$Condition, levels = c("het", "ko"))
# Repeat DESeq steps
# Construct a DESeqDataSet object
dds <- DESeqDataSetFromMatrix(countData = counts_combined,
colData = coldata,
design = ~ Condition)
# Run DESeq2
dds <- DESeq(dds)
resultsNames(dds)
# Output -
# "Intercept"            "Condition_KD_vs_mock"
res_shrunk <- lfcShrink(dds,
coef = "Condition_ko_vs_het",
type = "apeglm")
# Here's a nice article on empirical Bayes estimation - http://varianceexplained.org/r/empirical_bayes_baseball/
res_shrunk
# Compare the output of -
plotMA(res)
# and
plotMA(res_shrunk)
# Convert `res_shrunk` to a dataframe called `res_df`. We will use this for enrichment analyses
res_df <- as_tibble(res_shrunk, rownames = "genes")
#save the diffexp data
#write.csv(res_df, file = "20241205_deseq2_bayes_estimation.csv")
# Get ENTREZ IDs
# We'll need this for using the "org.Mm.eg.db" package
# Step One: Connect to the selected BioMart database and dataset hosted by Ensembl
ensembl <- useEnsembl(biomart = "genes",
dataset = "mmusculus_gene_ensembl")
#ensembl <- useMart("ENSEMBL_MART_ENSEMBL", host="may2009.archive.ensembl.org", dataset="mmusculus_gene_ensembl")
# Step Two: Retrieve gene names
# build a biomaRt query
# The getBM() function is the main query function in biomaRt
ensembl_to_entrez <- getBM(attributes = c("ensembl_gene_id", "external_gene_name",
"entrezgene_id"),
values = res_df$genes,
mart = ensembl)
# add this new info to res_df
